# ---- Secrets and local environments (never commit) ----
.env
.env.*
!.env.example
venv/
.venv/

# ---- Python caches ----
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ---- Frontend build output and packages ----
frontend/node_modules/
frontend/dist/

# ---- Large or regenerated files ----
# Hugging Face model downloads (several GB; re-downloaded on first run)
models/
.cache/
# FEVER parquet is downloaded by scripts/download_fever.py; keep only the fixed sample ids
data/fever/*
!data/fever/sample_ids.json
# Sample PDFs: only the NASA demo set is committed (US government works, ~9 MB)
data/samples/*
!data/samples/nasa/
# LLM response cache and temporary uploads
data/cache/
data/uploads/
# RAGTruth download (large, gated dataset)
data/ragtruth/
# Old project report (large PDF); keep a copy locally
docs/reports/*.pdf

# ---- Generated output ----
logs/
*.log

# ---- Local tooling, editors and OS files ----
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Local-only project notes (never pushed) ----
Project Documentation.md
