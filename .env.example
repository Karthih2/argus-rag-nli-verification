# Required
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
GROQ_API_KEY=gsk_...

# Optional (defaults shown; every setting is in backend/config.py)
DB_NAME=argus
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
CORS_ORIGINS=http://localhost:5173
# The calibration in backend/calibration/trust.json is fitted for this NLI model.
# If you switch to the large model, refit: python -m scripts.fit_trust
NLI_MODEL_NAME=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
RATE_LIMIT_PER_MINUTE=20
